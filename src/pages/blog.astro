---
import TagList from "../components/TagList.astro";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (left, right) => right.data.date.getTime() - left.data.date.getTime(),
);
---

<BaseLayout title="Blog" description="Engineering notes, essays, and platform articles." currentPath="/blog">
  <section>
    <p class="section-eyebrow">Blog</p>
    <h1>Articles in progress, organized as engineering notes.</h1>
    <p>
      The blog will favor field notes, implementation detail, and operational lessons over broad opinion pieces.
    </p>
  </section>

  <section class="grid" style="grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));">
    {
      posts.length === 0 ? (
        <article class="surface empty-state">
          <h2>No published posts yet.</h2>
          <p>Collection wiring is in place. Published entries will appear here once draft status is removed.</p>
        </article>
      ) : (
        posts.map((post) => (
          <article class="surface article-entry">
            <p class="article-entry__meta mono">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            </p>
            <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <TagList tags={post.data.tags} />
          </article>
        ))
      )
    }
  </section>
</BaseLayout>

<style>
  .article-entry,
  .empty-state {
    padding: 1.25rem;
    display: grid;
    gap: 1rem;
  }

  .article-entry__meta {
    margin-bottom: -0.4rem;
    color: var(--accent);
    font-size: 0.8rem;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .article-entry h3 a:hover {
    color: var(--accent);
  }

  .empty-state h2 {
    font-size: 1.2rem;
    line-height: 1.2;
  }
</style>
