---
import Callout from "../components/Callout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TagList from "../components/TagList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteTagline, siteTitle } from "../data/site";

const focusTags = [
  "Self-hosted infrastructure",
  "DevOps automation",
  "AI engineering workflows",
  "Observability",
  "Infrastructure as Code",
  "Secure remote access",
  "Legacy modernization",
];

const previewProjects = [
  {
    title: "Platform notebook",
    summary: "A structured home for implementation notes, architecture decisions, and operations patterns.",
    status: "In setup",
    tags: ["Astro", "Content", "Structure"],
  },
  {
    title: "Observability layer",
    summary: "A planned metrics and status layer for turning platform operations into visible engineering signals.",
    status: "Planned",
    tags: ["Grafana", "Prometheus", "IaC"],
  },
  {
    title: "Public-safe lab reporting",
    summary: "A publication model that turns private operations work into reusable public engineering articles.",
    status: "Framing",
    tags: ["Security", "Writing", "Operations"],
  },
];
---

<BaseLayout title="Home" description={siteTagline} currentPath="/">
  <section class="grid hero-grid">
    <div>
      <p class="section-eyebrow">Engineering field notebook</p>
      <h1>{siteTitle}</h1>
      <p class="lead">
        {siteTagline} A public notebook for infrastructure, automation, observability, and AI-assisted platform work.
      </p>
      <div class="button-row">
        <a class="button" href="/projects">Explore projects</a>
        <a class="button" data-variant="ghost" href="/architecture">Architecture notes</a>
      </div>
    </div>

    <Callout title="Current state">
      <p>Base site, navigation, agent guidance, and content collections are in place. The next layer turns that structure into public engineering material.</p>
      <div class="status-grid">
        <div class="status-card"><span>Site</span><strong>MVP</strong></div>
        <div class="status-card"><span>Content</span><strong>Drafting</strong></div>
        <div class="status-card"><span>Ops</span><strong>Private</strong></div>
      </div>
    </Callout>
  </section>

  <section>
    <p class="section-eyebrow">Focus</p>
    <TagList tags={focusTags} />
  </section>

  <section>
    <p class="section-eyebrow">Preview</p>
    <div class="content-grid">
      {previewProjects.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>
</BaseLayout>
