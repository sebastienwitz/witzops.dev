---
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projectCards = (await getCollection("projects")).sort(
  (left, right) => left.data.order - right.data.order,
);
---

<BaseLayout title="Projects" description="Portfolio projects and implementation notes." currentPath="/projects">
  <section>
    <p class="section-eyebrow">Projects</p>
    <h1>Active engineering tracks and public implementation notes.</h1>
    <p>
      This section will gather build logs, patterns, and concise retrospectives rather than polished case-study
      marketing.
    </p>
  </section>

  <section class="grid" style="grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));">
    {
      projectCards.length === 0 ? (
        <article class="surface empty-state">
          <h2>No projects published yet.</h2>
          <p>Collection wiring is in place. Project entries will appear here as they are added.</p>
        </article>
      ) : (
        projectCards.map((project) => (
          <ProjectCard
            title={project.data.title}
            summary={project.data.description}
            status={project.data.status}
            tags={project.data.tags}
            href={`/projects/${project.id}`}
          />
        ))
      )
    }
  </section>
</BaseLayout>

<style>
  .empty-state {
    padding: 1.25rem;
    display: grid;
    gap: 1rem;
  }

  .empty-state h2 {
    font-size: 1.2rem;
    line-height: 1.2;
  }
</style>
