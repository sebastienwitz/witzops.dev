---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<ul class="tag-list" aria-label="Tags">
  {tags.map((tag) => <li>{tag}</li>)}
</ul>

<style>
  .tag-list { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tag-list li { padding: 0.3rem 0.62rem; border-radius: var(--radius); border: 1px solid var(--line-strong); background: rgba(255, 255, 255, 0.035); color: #c9d1d8; font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0; }
</style>
