---
import TagList from "./TagList.astro";

interface Props {
  title: string;
  summary: string;
  status: string;
  tags: string[];
}

const { title, summary, status, tags } = Astro.props;
---

<article class="surface interactive-card project-card">
  <div class="project-card__header">
    <h3 class="card-title">{title}</h3>
    <span class="mono">{status}</span>
  </div>
  <p>{summary}</p>
  <TagList tags={tags} />
</article>

<style>
  .project-card { min-height: 12rem; padding: 1.2rem; display: grid; gap: 0.9rem; align-content: start; transition: border-color 150ms ease; }
  .project-card:hover { border-color: var(--line-strong); }
  .project-card__header { display: flex; gap: 1rem; align-items: flex-start; justify-content: space-between; }
  .project-card__header span { flex: 0 0 auto; padding: 0.25rem 0.52rem; border: 1px solid var(--accent-line); border-radius: var(--radius); background: rgba(85, 199, 232, 0.07); color: var(--accent-strong); font-size: 0.72rem; letter-spacing: 0; line-height: 1.2; text-transform: uppercase; }
  .project-card p { margin-bottom: 0; }
  @media (max-width: 40rem) { .project-card__header { flex-direction: column; align-items: flex-start; } }
</style>
