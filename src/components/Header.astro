---
import { navigationItems, siteTagline, siteTitle } from "../data/site";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="WitzOps home">
      <img class="site-header__mark" src="/brand/witzops-mark-128.png" alt="" width="34" height="34" />
      <span>
        <span class="site-header__name">{siteTitle}</span>
        <span class="site-header__tagline">{siteTagline}</span>
      </span>
    </a>

    <nav aria-label="Primary">
      <ul class="site-header__nav">
        {
          navigationItems.map((item) => {
            const isActive = item.href === currentPath;

            return (
              <li>
                <a href={item.href} aria-current={isActive ? "page" : undefined} data-active={isActive}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--line);
    background: rgba(8, 9, 11, 0.86);
    backdrop-filter: blur(18px);
  }

  .site-header__inner {
    width: min(calc(100% - 2rem), var(--content-width));
    margin: 0 auto;
    padding: 0.82rem 0;
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
  }

  .site-header__brand {
    display: inline-flex;
    gap: 0.72rem;
    align-items: center;
    min-width: max-content;
  }

  .site-header__mark {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
  }

  .site-header__brand span span {
    display: block;
  }

  .site-header__name {
    color: var(--text);
    font-size: 0.98rem;
    font-weight: 680;
    letter-spacing: 0;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .site-header__tagline {
    margin-top: 0.12rem;
    color: var(--text-soft);
    font-size: 0.76rem;
    line-height: 1.1;
  }

  .site-header__nav {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem;
    padding: 0;
    margin: 0;
  }

  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.68rem;
    border-radius: var(--radius);
    color: var(--text-soft);
    border: 1px solid transparent;
    font-size: 0.88rem;
    transition: border-color 120ms ease, color 120ms ease, background-color 120ms ease;
  }

  .site-header__nav a:hover,
  .site-header__nav a[data-active="true"] {
    color: var(--text);
    border-color: var(--line-strong);
    background: rgba(255, 255, 255, 0.04);
  }

  @media (max-width: 56rem) {
    .site-header__inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-header__nav {
      justify-content: flex-start;
    }
  }

  @media (max-width: 36rem) {
    .site-header__tagline {
      display: none;
    }
  }
</style>
