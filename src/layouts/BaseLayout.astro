---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { siteTagline, siteTitle } from "../data/site";

interface Props {
  title: string;
  description?: string;
  currentPath: string;
}

const { title, description = siteTagline, currentPath } = Astro.props;
const documentTitle = `${title} | ${siteTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/brand/witzops-mark.svg" />
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #070b10;
        --bg-elevated: #0f1720;
        --bg-muted: #0b1118;
        --bg-panel: rgba(14, 22, 31, 0.78);
        --line: rgba(128, 157, 188, 0.16);
        --line-strong: rgba(143, 183, 222, 0.34);
        --text: #edf4fb;
        --text-soft: #aab8c8;
        --text-muted: #718197;
        --accent: #7ed7ff;
        --accent-strong: #d6f3ff;
        --accent-warm: #f6c177;
        --accent-soft: rgba(126, 215, 255, 0.13);
        --accent-line: rgba(126, 215, 255, 0.32);
        --content-width: 76rem;
        --space-xs: 0.5rem;
        --space-sm: 0.75rem;
        --space-md: 1rem;
        --space-lg: 1.5rem;
        --space-xl: 2rem;
        --space-2xl: 3rem;
        --space-3xl: 4.5rem;
        --radius: 1rem;
        --radius-lg: 1.4rem;
        --shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
        --font-sans: "IBM Plex Sans", "Inter", "Segoe UI", sans-serif;
        --font-mono: "IBM Plex Mono", "SFMono-Regular", Consolas, monospace;
      }

      * {
        box-sizing: border-box;
      }

      html {
        background:
          radial-gradient(circle at 18% -10%, rgba(126, 215, 255, 0.18), transparent 28rem),
          radial-gradient(circle at 86% 6%, rgba(246, 193, 119, 0.08), transparent 24rem),
          linear-gradient(180deg, #05080d 0%, var(--bg) 48%, #060a0f 100%);
        background-color: var(--bg);
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        font-family: var(--font-sans);
        line-height: 1.65;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background-image:
          linear-gradient(rgba(143, 183, 222, 0.045) 1px, transparent 1px),
          linear-gradient(90deg, rgba(143, 183, 222, 0.045) 1px, transparent 1px);
        background-size: 4rem 4rem;
        mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.9), transparent 75%);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      main {
        width: min(calc(100% - 2rem), var(--content-width));
        margin: 0 auto;
        padding: var(--space-3xl) 0 5rem;
      }

      section + section {
        margin-top: var(--space-3xl);
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1,
      h2,
      h3 {
        color: var(--text);
        letter-spacing: -0.04em;
      }

      h1 {
        max-width: 13ch;
        margin-bottom: 1.1rem;
        font-size: clamp(3rem, 7vw, 6.6rem);
        line-height: 0.92;
      }

      h2 {
        margin-bottom: 0.85rem;
        font-size: clamp(1.65rem, 3vw, 2.6rem);
        line-height: 1.05;
      }

      h3 {
        margin-bottom: 0;
        font-size: 1.08rem;
        line-height: 1.25;
      }

      p {
        color: var(--text-soft);
      }

      p:last-child {
        margin-bottom: 0;
      }

      ul {
        color: var(--text-soft);
      }

      code,
      .mono {
        font-family: var(--font-mono);
      }

      .lead {
        max-width: 46rem;
        color: #c5d2e0;
        font-size: clamp(1.05rem, 1.6vw, 1.28rem);
      }

      .section-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        margin-bottom: var(--space-md);
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 0.78rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .section-eyebrow::before {
        content: "";
        width: 1.6rem;
        height: 1px;
        background: currentColor;
        box-shadow: 0 0 16px currentColor;
      }

      .surface {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background:
          linear-gradient(180deg, rgba(18, 28, 39, 0.88), rgba(8, 13, 20, 0.95)),
          radial-gradient(circle at top left, rgba(126, 215, 255, 0.08), transparent 18rem);
        box-shadow: var(--shadow);
      }

      .surface::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        border-radius: inherit;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.07), transparent 34%);
        opacity: 0.7;
      }

      .surface > * {
        position: relative;
      }

      .grid {
        display: grid;
        gap: var(--space-lg);
      }

      .hero-grid {
        grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.75fr);
        align-items: end;
        gap: clamp(2rem, 5vw, 4rem);
      }

      .content-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
        gap: var(--space-lg);
      }

      .page-header {
        max-width: 58rem;
      }

      .stack-list {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
      }

      .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        margin-top: 1.6rem;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.8rem;
        padding: 0.7rem 1rem;
        border: 1px solid var(--line-strong);
        border-radius: 999px;
        background: rgba(126, 215, 255, 0.1);
        color: var(--accent-strong);
        font-family: var(--font-mono);
        font-size: 0.82rem;
        letter-spacing: 0.04em;
        transition: transform 140ms ease, border-color 140ms ease, background-color 140ms ease;
      }

      .button:hover {
        transform: translateY(-1px);
        border-color: var(--accent-line);
        background: rgba(126, 215, 255, 0.16);
      }

      .button[data-variant="ghost"] {
        background: rgba(255, 255, 255, 0.035);
        color: var(--text-soft);
      }

      .mini-panel {
        padding: 1.2rem;
        border: 1px solid var(--line);
        border-radius: 0.9rem;
        background: rgba(255, 255, 255, 0.035);
      }

      .mini-panel strong {
        display: block;
        color: var(--text);
      }

      .status-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.7rem;
        margin-top: 1rem;
      }

      .status-card {
        padding: 0.85rem;
        border: 1px solid var(--line);
        border-radius: 0.85rem;
        background: rgba(4, 9, 14, 0.42);
      }

      .status-card span {
        display: block;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .status-card strong {
        display: block;
        margin-top: 0.25rem;
        color: var(--accent-strong);
        font-size: 1.05rem;
      }

      @media (max-width: 48rem) {
        main {
          width: min(calc(100% - 1.25rem), var(--content-width));
          padding-top: 2.35rem;
        }

        .hero-grid,
        .status-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <Header currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
