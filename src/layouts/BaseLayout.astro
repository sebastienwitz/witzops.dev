---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { siteTagline, siteTitle } from "../data/site";

interface Props {
  title: string;
  description?: string;
  currentPath: string;
}

const { title, description = siteTagline, currentPath } = Astro.props;
const documentTitle = `${title} | ${siteTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #0b1116;
        --bg-elevated: #121922;
        --bg-muted: #0f151d;
        --line: #213040;
        --line-strong: #31465d;
        --text: #e7edf4;
        --text-soft: #9fb0c2;
        --accent: #8fb7de;
        --accent-soft: rgba(143, 183, 222, 0.14);
        --content-width: 72rem;
        --space-xs: 0.5rem;
        --space-sm: 0.75rem;
        --space-md: 1rem;
        --space-lg: 1.5rem;
        --space-xl: 2rem;
        --space-2xl: 3rem;
        --radius: 0.85rem;
        --shadow: 0 16px 48px rgba(0, 0, 0, 0.22);
        --font-sans:
          "IBM Plex Sans", "Segoe UI", sans-serif;
        --font-mono:
          "IBM Plex Mono", "SFMono-Regular", Consolas, monospace;
      }

      * {
        box-sizing: border-box;
      }

      html {
        background:
          radial-gradient(circle at top, rgba(74, 97, 123, 0.18), transparent 30%),
          linear-gradient(180deg, #0a0f14 0%, var(--bg) 100%);
        background-color: var(--bg);
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        font-family: var(--font-sans);
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      main {
        width: min(calc(100% - 2rem), var(--content-width));
        margin: 0 auto;
        padding: var(--space-2xl) 0 4rem;
      }

      section + section {
        margin-top: var(--space-2xl);
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1,
      h2,
      h3 {
        letter-spacing: -0.02em;
      }

      h1 {
        font-size: clamp(2.4rem, 5vw, 4.25rem);
        line-height: 1.05;
      }

      h2 {
        font-size: clamp(1.5rem, 3vw, 2.2rem);
        line-height: 1.15;
      }

      h3 {
        font-size: 1.05rem;
        line-height: 1.25;
      }

      p {
        color: var(--text-soft);
      }

      code,
      .mono {
        font-family: var(--font-mono);
      }

      .section-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: var(--space-md);
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .section-eyebrow::before {
        content: "";
        width: 1.4rem;
        height: 1px;
        background: currentColor;
      }

      .surface {
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: linear-gradient(180deg, rgba(18, 25, 34, 0.92), rgba(13, 19, 27, 0.96));
        box-shadow: var(--shadow);
      }

      .grid {
        display: grid;
        gap: var(--space-lg);
      }

      .hero-grid {
        grid-template-columns: minmax(0, 1.5fr) minmax(16rem, 0.9fr);
        align-items: end;
      }

      .stack-list {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
      }

      @media (max-width: 48rem) {
        main {
          width: min(calc(100% - 1.25rem), var(--content-width));
          padding-top: 2rem;
        }

        .hero-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <Header currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
